# ── Sicherheit ────────────────────────────────────────────────────────────────
JWT_SECRET=hier-einen-langen-zufaelligen-string-einsetzen
JWT_EXPIRES_IN=8h
AUTO_LOGOUT_MINUTES=60

# ── Frontend-URL (für CORS) ───────────────────────────────────────────────────
# Auf welcher Adresse ist das Frontend erreichbar?
FRONTEND_URL=http://localhost:3000

# ── SelectLine ────────────────────────────────────────────────────────────────
SELECTLINE_API_URL=http://dein-selectline-server:port/api/v1
SELECTLINE_USERNAME=api_benutzer
SELECTLINE_PASSWORD=api_passwort
SELECTLINE_MANDANT=DEIN_MANDANT
SELECTLINE_IGNORE_SSL=false

# Barzahler: Zahlungsarten (Payment.PaymentTerm), bei denen eine Rechnung den Lieferschein NICHT
# automatisch abschließt (Standard 14 = Barzahlung bei Anlieferung). Mehrere per Komma: 14,15
BARZAHLER_ZAHLUNGSARTEN=14

# ── Web Push / VAPID (optional) ───────────────────────────────────────────────
# Generieren mit: cd backend && npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── Versionsprüfung (optional) ────────────────────────────────────────────────
# GitHub-Repo, gegen das "Mein Konto" die laufende Version vergleicht.
# GITHUB_TOKEN nur nötig bei privatem Repo (Lesezugriff genügt).
GITHUB_REPO=mauschi799/orderdesk
GITHUB_TOKEN=

# ── Updater-Container: "Version aktualisieren" in Mein Konto ──────────────────
# Geheimes Token, mit dem das Backend den Updater anspricht (openssl rand -hex 24).
# update.sh legt es bei Bedarf automatisch an. Leer = Update-Button deaktiviert.
UPDATER_TOKEN=
